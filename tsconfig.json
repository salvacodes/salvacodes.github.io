{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist", "node_modules", ".astro"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "types": ["astro/client"],
    "baseUrl": ".",
    "paths": {
      "@features/*": ["src/features/*"],
      "@desktop/*": ["src/desktop/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
